# TJU AI Agent Competition API
# Get the dedicated API Key and endpoint from https://ai.tju.edu.cn personal center.
# OpenAI SDK base_url must stop at the repository name; the SDK appends
# /chat/completions automatically.
TJU_API_KEY=
TJU_API_BASE=https://ai.tju.edu.cn/api/agent2026/agent2026-netpilot
TJU_MODEL=tju-llm

# NetPilot agent defaults
MAX_TOOL_ROUNDS=6
MAX_HISTORY_MESSAGES=20

# NetPilot tool defaults
TOOL_MODE=mock
MOCK_SCENARIO=healthy
NETWORK_TIMEOUT_SECONDS=5

# NetPilot RAG defaults
RAG_ENABLED=true
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RAG_TOP_K=4

# NetPilot application defaults
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=false

# Upstream Claude / Anthropic example (optional)
ANTHROPIC_API_KEY=replace_me
CLAUDE_MODEL=claude-opus-4-6

# Upstream lab defaults
NETWORK_USERNAME=admin
NETWORK_PASSWORD=admin
NETWORK_DEVICE_TYPE=arista_eos

# Upstream MCP server
MCP_HOST=0.0.0.0
MCP_PORT=8000
